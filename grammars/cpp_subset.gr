# A practical subset of C++ (declarations, classes, functions, statements and
# the full C++ expression-precedence ladder). NOT the complete ISO grammar:
# templates, overloading, casts, lambdas and user-defined types are omitted.
# Preprocessor lines (#include ...) and comments are skipped by the lexer.
%comments c
translation_unit -> external_decl*
external_decl    -> using_decl | namespace_def | class_def | function_def | declaration
using_decl       -> 'using' 'namespace' ID ';'
namespace_def    -> 'namespace' ID '{' external_decl* '}'
class_def        -> ('class' | 'struct') ID '{' member* '}' ';'
member           -> access_spec | function_def | declaration
access_spec      -> ('public' | 'private' | 'protected') ':'
function_def     -> type_spec declarator '(' param_list? ')' compound_stmt
param_list       -> param (',' param)*
param            -> type_spec declarator
declaration      -> type_spec init_declarator (',' init_declarator)* ';'
init_declarator  -> declarator ('=' assignment_expr)?
declarator       -> ('*' | '&')* ID ('[' NUMBER ']')*
type_spec        -> 'const'? base_type
base_type        -> 'int' | 'float' | 'double' | 'char' | 'bool' | 'void' | 'auto' | 'long' | 'short' | 'string'
compound_stmt    -> '{' statement* '}'
statement        -> compound_stmt | selection_stmt | iteration_stmt | jump_stmt | declaration | expr_stmt
selection_stmt   -> 'if' '(' expression ')' statement ('else' statement)?
                  | 'switch' '(' expression ')' '{' case_clause* '}'
case_clause      -> ('case' conditional_expr | 'default') ':' statement*
iteration_stmt   -> 'while' '(' expression ')' statement
                  | 'do' statement 'while' '(' expression ')' ';'
                  | 'for' '(' for_init expression? ';' expression? ')' statement
for_init         -> declaration | expr_stmt
jump_stmt        -> 'return' expression? ';' | 'break' ';' | 'continue' ';'
expr_stmt        -> expression? ';'
expression       -> assignment_expr (',' assignment_expr)*
assignment_expr  -> conditional_expr (assign_op assignment_expr)?
assign_op        -> '=' | '+=' | '-=' | '*=' | '/=' | '%='
conditional_expr -> logical_or ('?' expression ':' conditional_expr)?
logical_or       -> logical_and ('||' logical_and)*
logical_and      -> bit_or ('&&' bit_or)*
bit_or           -> bit_xor ('|' bit_xor)*
bit_xor          -> bit_and ('^' bit_and)*
bit_and          -> equality ('&' equality)*
equality         -> relational (('==' | '!=') relational)*
relational       -> shift (('<' | '>' | '<=' | '>=') shift)*
shift            -> additive (('<<' | '>>') additive)*
additive         -> multiplicative (('+' | '-') multiplicative)*
multiplicative   -> unary (('*' | '/' | '%') unary)*
unary            -> ('++' | '--' | '+' | '-' | '!' | '~' | '*' | '&') unary
                  | 'sizeof' unary
                  | postfix
postfix          -> primary postfix_op*
postfix_op       -> '[' expression ']' | '(' arg_list? ')' | '.' ID | '->' ID | '++' | '--'
arg_list         -> assignment_expr (',' assignment_expr)*
primary          -> NUMBER | STRING | CHAR | 'true' | 'false' | 'nullptr' | ID ('::' ID)* | '(' expression ')'
